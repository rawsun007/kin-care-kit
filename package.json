{
  "name": "kin-care-kit",
  "version": "1.0.0",
  "description": "Medicine charts, emergency cards, a care page, a weekly email and a group-chat card for a family looking after a parent, in the parent’s language. Built with Hyper Elements.",
  "main": "index.js",
  "scripts": {
    "check": "hyper-elements check templates",
    "build": "tsx scripts/build.tsx",
    "brands": "tsx scripts/brands.tsx",
    "clients": "tsx scripts/clients.tsx",
    "typecheck": "tsc --noEmit",
    "all": "npm run check && npm run build && npm run brands && npm run clients"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hyper-elements/email-clients": "^0.5.3",
    "@hyper-elements/lint": "^0.1.11",
    "@hyper-elements/react": "^0.5.2",
    "@react-pdf/renderer": "^4.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.33.5"
  },
  "devDependencies": {
    "@hyper-elements/cli": "^0.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "hyperElements": {
    "templates": [
      "templates/**",
      "families/**"
    ]
  }
}
